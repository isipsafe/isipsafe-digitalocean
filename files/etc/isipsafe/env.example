# Copy to /etc/isipsafe/env (chmod 600) or run /opt/isipsafe/setup.sh.
# Free API key: https://isipsafe.com/login
ISIPSAFE_API_KEY=

# Report addresses banned by fail2ban to isIPsafe (yes/no).
ISIPSAFE_REPORT=yes

# Drop traffic from the isIPsafe blocklist (yes/no) and how strict it is.
ISIPSAFE_BLOCKLIST=yes
ISIPSAFE_BLOCKLIST_CONFIDENCE=90
ISIPSAFE_BLOCKLIST_DAYS=30
ISIPSAFE_BLOCKLIST_LIMIT=10000
ISIPSAFE_BLOCKLIST_EXCEPT_COUNTRIES=
