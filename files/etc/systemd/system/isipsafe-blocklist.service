[Unit]
Description=Update the isIPsafe blocklist
Documentation=https://github.com/isipsafe/isipsafe-digitalocean
Wants=network-online.target
After=network-online.target isipsafe-firewall.service

[Service]
Type=oneshot
ExecStart=/opt/isipsafe/bin/isipsafe-blocklist update
TimeoutStartSec=5min
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/isipsafe
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
